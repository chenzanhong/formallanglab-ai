# AI模块环境变量配置示例
# =========================================================
# 重要说明：
# 1. 此文件包含敏感信息的占位符，请不要直接在生产环境中使用
# 2. 请创建一个实际的.env文件（不要提交到版本控制系统），填入真实的密钥值
# 3. 在Docker环境中，建议通过环境变量或Docker Secrets传递敏感信息
# 4. 开发环境可以使用此模板创建.env文件并填入测试值
# 5. 使用docker-compose时，REDIS_HOST已配置为容器名称"redis"
# =========================================================

# OpenAI/DashScope API配置
# 注意：此为敏感信息，生产环境务必使用环境变量或Docker Secrets
DASHSCOPE_API_KEY=your_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus-2025-09-11

# Redis配置
# 在Docker Compose环境中使用服务名称，在单机环境中使用host.docker.internal
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 性能分析端口
PPROF_PORT=6060

# 服务端口（覆盖配置文件中的设置）
SERVER_PORT=8082

# JWT密钥
# 注意：此为敏感信息，生产环境务必使用强密钥并通过安全方式传递
JWT_KEY=your_jwt_secret_key_here

# QA缓存目录
# 在Docker环境中，建议将此目录挂载为卷以持久化数据
QA_CACHE_DIR=./asset/qacache

# ChromaDB配置（如果使用RAG功能）
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=FormalLangLab_knowledge

# 运行容器时的环境变量覆盖示例：
# docker run -e DASHSCOPE_API_KEY=实际密钥 -e REDIS_HOST=host.docker.internal gdesign-ai

# ================================
# docker-compose 专用配置
# ================================
# 使用docker-compose启动服务：
# 1. 创建.env文件并填入实际的API密钥和敏感信息
# 2. 执行：docker-compose up -d
# 3. 停止服务：docker-compose down

# 日志级别（可选）
LOG_LEVEL=info

# 是否启用调试模式
DEBUG_MODE=false